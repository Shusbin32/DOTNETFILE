@page
@model LoginSystem.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-body text-center">
                    <h1 class="card-title">@ViewData["Title"]</h1>
                    @{
                        if (Model.StatusMessage != null)
                        {
                            var statusMessageClass = Model.StatusMessage.StartsWith("Error") ? "danger" : "success";
                            <div class="alert alert-@statusMessageClass" role="alert">
                                @Model.StatusMessage
                            </div>
                        }
                    }
                    <p>
                        <a asp-page="./Login" class="btn btn-primary">Proceed to Login</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div> 